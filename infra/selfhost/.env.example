# CorteQS kendi veri katmanı — ortam değişkeni ŞABLONU
#
# ⚠️ Bu dosya yalnız ANAHTAR ADLARINI içerir. Gerçek değer YAZILMAZ ve git'e GİRMEZ.
# Kopyala: cp .env.example .env   (infra/selfhost/.env .gitignore'dadır)
#
# ⚠️ MÜKERRER ANAHTAR TUZAĞI (2026-08-05'te bu projede yaşandı): dotenv aynı anahtarın
#    SON tanımını kullanır. Bu dosyayı .env'in ÜZERİNE yapıştırma — gerçek sırlar
#    sessizce placeholder'a düşer. Kontrol:
#      grep -oE '^[A-Za-z_][A-Za-z0-9_]*=' .env | sort | uniq -d    # BOŞ dönmeli

# ─────────────────────────────────────────────────────────── Postgres
POSTGRES_DB=postgres
# Güçlü parola üret: openssl rand -base64 36
POSTGRES_PASSWORD=

# ─────────────────────────────────────────────────────────── JWT / anahtarlar
#
# 🔑 EN KRİTİK AYAR.
# JWT_SECRET, Supabase projesindeki JWT secret ile BİREBİR AYNI olmalıdır.
# Nereden alınır: Supabase Dashboard → Project Settings → API → JWT Settings → JWT Secret
#
# Aynı olursa:
#   • Mevcut anon key ve service_role key DEĞİŞMEDEN çalışır
#   • Kullanıcıların açık oturumları DÜŞMEZ (token'lar doğrulanmaya devam eder)
#   • Frontend'de yalnız URL değişir
# Farklı olursa:
#   • Tüm kullanıcılar anında çıkış yapmış olur ve anon key geçersizleşir
JWT_SECRET=
JWT_EXPIRY=3600

# Supabase Cloud'daki issuer ile aynı olmalı ki mevcut token'lar geçerli kalsın.
# Biçim: https://<PROJE_REF>.supabase.co/auth/v1
JWT_ISSUER=

# Mevcut anahtarların AYNISI (değiştirme — frontend onları kullanmaya devam eder)
ANON_KEY=
SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────── URL'ler
# Geçidin dışarıdan görünen adresi. Frontend VITE_SUPABASE_URL bununla aynı olur.
API_EXTERNAL_URL=https://api.corteqs.net
SITE_URL=https://corteqs.net
# Virgülle ayrılmış; parola sıfırlama ve OAuth dönüşleri buraya kısıtlanır.
ADDITIONAL_REDIRECT_URLS=https://corteqs.net/**,https://www.corteqs.net/**

# ─────────────────────────────────────────────────────────── Geçit
# Yalnız Coolify ters proxy'si erişsin diye loopback'e bağlanır.
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8000

# ─────────────────────────────────────────────────────────── Auth davranışı
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# Google OAuth — kodda kullanılan TEK sağlayıcı.
# ⚠️ Google Cloud Console'da "Authorized redirect URI" listesine
#    ${API_EXTERNAL_URL}/auth/v1/callback EKLENMELİDİR, yoksa giriş redirect_uri_mismatch verir.
ENABLE_GOOGLE_OAUTH=true
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_SECRET=

# ─────────────────────────────────────────────────────────── SMTP (mevcut Zoho)
# ⚠️ SMTP_ADMIN_EMAIL, Zoho hesabının kendisi veya alias'ı OLMAK ZORUNDA — aksi
#    halde Zoho 553 döner (projenin mevcut .env.example'ında da yazan kural).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=CorteQS

# ─────────────────────────────────────────────────────────── Storage
# S3 GEREKMİYOR — yerel disk kullanılıyor (STORAGE_BACKEND=file).
FILE_SIZE_LIMIT=52428800
STORAGE_TENANT_ID=corteqs
REGION=eu-central-1
GLOBAL_S3_BUCKET=corteqs

# ─────────────────────────────────────────────────────────── Realtime
# openssl rand -base64 48   (en az 64 karakter olmalı)
SECRET_KEY_BASE=
# openssl rand -base64 24
REALTIME_DB_ENC_KEY=

# ─────────────────────────────────────────────────────────── PostgREST
# ⚠️ 1000'i DEĞİŞTİRME. Supabase Cloud da 1000 kullanıyor; farklı yaparsan
#    sayfalama hataları burada gizlenip canlıda ortaya çıkar.
PGRST_DB_MAX_ROWS=1000
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
