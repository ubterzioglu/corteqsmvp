VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_ANON_KEY"
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
ZOHO_SMTP_HOST="smtp.zoho.eu"
ZOHO_SMTP_PORT="465"
ZOHO_SMTP_USER="YOUR_ZOHO_SENDER_ADDRESS"
ZOHO_SMTP_PASSWORD="YOUR_ZOHO_APP_PASSWORD"
# MAIL_FROM, Zoho SMTP hesabının kendisi (veya alias'ı) olmak ZORUNDA — aksi halde 553 döner.
MAIL_FROM="noreply@example.com"
MAIL_TO_ADMIN="admin@example.com"
MAIL_REPLY_TO="support@example.com"
MAIL_SEND_CONFIRMATION="true"
RAG_API_SECRET="YOUR_RAG_API_SECRET"

# Meta WhatsApp Cloud API — yalnız Supabase Edge/server ortamında tutulur.
# Bu adların hiçbirini VITE_ ile başlatmayın. Webhook deploy edilmeden önce dördü de
# `supabase secrets set` ile tanımlanmalıdır.
WHATSAPP_ACCESS_TOKEN="YOUR_META_SYSTEM_USER_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="YOUR_META_PHONE_NUMBER_ID"
WHATSAPP_VERIFY_TOKEN="YOUR_RANDOM_WEBHOOK_VERIFY_TOKEN"
WHATSAPP_APP_SECRET="YOUR_META_APP_SECRET"
# Secret değildir; Meta sürüm emekliliklerinde operasyonel olarak güncellenir.
WHATSAPP_GRAPH_API_VERSION="v26.0"

# Bildirim e-postaları (yeni üye + admin güncellemeleri).
# send-notification-emails Edge Function'ının paylaşılan sırrı; scripts/sync-admin-updates.mjs
# ve DB'deki poke_notification_dispatcher() bu değerle x-dispatch-secret header'ını gönderir.
# DB tarafına ayrıca notification_settings tablosuna elle yazılır (dispatch.url / dispatch.secret).
NOTIFY_DISPATCH_SECRET="YOUR_DISPATCH_SECRET"

# Service Finder worker (workers/service-finder — ayrı Coolify uygulaması)
TAVILY_API_KEY="YOUR_TAVILY_API_KEY"
SERPAPI_API_KEY="YOUR_SERPAPI_API_KEY"
SERVICE_FINDER_WORKER_ID="sf-worker-1"
SERVICE_FINDER_POLL_MS="5000"
SERVICE_FINDER_HEARTBEAT_MS="60000"
SERVICE_FINDER_ENABLE_SERPAPI_FALLBACK="true"
